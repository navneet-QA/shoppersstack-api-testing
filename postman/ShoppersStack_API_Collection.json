        {
          "name": "Register as Admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `kest${Date.now()}@gmail.com`;",
                  "pm.globals.set(\"random\", email);",
                  "",
                  "const phone = `+91${Math.floor(6000000000 + Math.random() * 4000000000)}`;",
                  "pm.globals.set(\"phone\", phone);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response message is BAD_REQUEST\", function () {",
                  "    if (pm.response.text() && pm.response.text().trim().length > 0) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.message).to.eql(\"BAD_REQUEST\");",
                  "    } else {",
                  "        pm.expect.fail(\"Response body is empty; expected a BAD_REQUEST message\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Response contains error details for phone\", function () {",
                  "    if (pm.response.text() && pm.response.text().trim().length > 0) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(JSON.stringify(jsonData)).to.include(\"phone\");",
                  "    } else {",
                  "        pm.expect.fail(\"Response body is empty; expected error details for phone\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
