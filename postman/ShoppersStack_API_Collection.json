              "raw": "{{baseUrl}}/shopping/shoppers",
              "protocol": "https",
              "host": [
                "www",
                "shoppersstack",
                "com"
              ],
              "path": [
                "shopping",
                "shoppers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Find shoppers data by shopper id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Check that the response status code is 403",
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "// 2. Check that the response time is under 3000ms",
                  "pm.test(\"Response time is under 3000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/shopping/shoppers/{{shopperId}}",
              "protocol": "https",
