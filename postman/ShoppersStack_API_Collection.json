                "com"
              ],
              "path": [
                "shopping",
                "shoppers",
                "{{shopperId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Shoppers Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `{{shopperEmail}}`;\r",
                  "pm.globals.set(\"random\", email);\r",
                  "\r",
                  "const phone = `${Math.floor(6000000000 + Math.random() * 4000000000)}`;\r",
                  "pm.globals.set(\"phone\", phone);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is less than 200ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);\r",
                  "});\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "    \r",
                  "pm.globals.set(\"token\", jsonData.data.jwtToken);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"{{shopperEmail}}\", \r\n    \"password\": \"{{shopperPassword}}\", \r\n    \"role\": \"SHOPPER\"\r\n    }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/shopping/users/login",
